#!/bin/sh

export PYTHONWARNINGS="ignore"

# Seconds between progress reports from run_progress.
PROGRESS_INTERVAL="${PROGRESS_INTERVAL:-120}"

# Run ${1} on ${THIS_ANIMAL} and report its progress while it runs.
# salt-ssh -r returns a command's output only after the command exits,
# so the command writes its output to a log file in the remote home
# directory, and a separate salt-ssh call prints the last line of that
# log every ${PROGRESS_INTERVAL} seconds. The full output is printed
# when the command finishes, as before. The command runs under sh -c
# because the login shell on some animals is not a POSIX shell, so ${1}
# must not contain single quotes. Standard input is /dev/null, so a
# command that prompts for input fails instead of waiting forever.
# Returns the exit status of salt-ssh.
run_progress()
{
	_log=".$(basename "${0}")-${THIS_ANIMAL}.log"

	salt-ssh "${THIS_ANIMAL}" -r "sh -c '( ${1} ) < /dev/null > ${_log} 2>&1; _rc=\$?; cat ${_log}; rm -f ${_log}; exit \${_rc}'" &
	_pid=${!}
	trap 'kill ${_pid} 2> /dev/null; exit 130' INT TERM

	_start=$(date +%s)
	_next=$((_start + PROGRESS_INTERVAL))
	while kill -0 ${_pid} 2> /dev/null; do
		sleep 1
		_now=$(date +%s)
		if [ "${_now}" -lt "${_next}" ]; then
			continue
		fi
		_next=$((_now + PROGRESS_INTERVAL))
		_line=$(salt-ssh "${THIS_ANIMAL}" --out json -r "tail -n 5 ${_log}" 2> /dev/null | sed -n '/{/,$p' | jq -r ".${THIS_ANIMAL}.stdout" 2> /dev/null | tr '\r' '\n' | grep -v '^[[:space:]]*$' | tail -n 1 | cut -c 1-100)
		kill -0 ${_pid} 2> /dev/null || break
		echo "$(date '+%H:%M:%S') ${THIS_ANIMAL} still running" \
			"($(((_now - _start) / 60))m): ${_line}"
	done

	wait ${_pid}
	_rc=${?}
	trap - INT TERM
	return ${_rc}
}

do_work()
{
	OSJSON=$(salt-ssh "${THIS_ANIMAL}" --out json -r 'cat /etc/os-release' | sed -n '/{/,$p')
	RETCODE=$(printf "%s" "${OSJSON}" | jq -r ".${THIS_ANIMAL} | if type == \"object\" then .retcode else \"none\" end")
	if [ ! "${RETCODE}" = "0" ]; then
		echo "Could not retrieve /etc/os-release from ${THIS_ANIMAL} (retcode ${RETCODE}):"
		printf "%s\n" "${OSJSON}" | jq -r ".${THIS_ANIMAL} | if type == \"object\" then (.stdout, .stderr) | select(. != \"\") else . end"
		return 1
	fi

	OSRELEASE=$(printf "%s" "${OSJSON}" | jq -r ".${THIS_ANIMAL}.stdout")
	if [ "${OSRELEASE}" = "" ]; then
		echo "Could not retrieve /etc/os-release from ${THIS_ANIMAL}"
		return 1
	fi

	OSID=$(printf "%s" "${OSRELEASE}" | grep '^ID=' | cut -d= -f2 | tr -d '"')
	if [ "${OSID}" = "" ]; then
		echo "Could not identify OS of ${THIS_ANIMAL}"
		return 1
	fi

	OSVERSIONID=$(printf "%s" "${OSRELEASE}" | grep '^VERSION_ID=' | cut -d= -f2 | tr -d '"')
	if [ "${OSVERSIONID}" = "" ]; then
		echo "Could not identify OS version of ${THIS_ANIMAL}"
		return 1
	fi

	echo "${THIS_ANIMAL} is ${OSID} ${OSVERSIONID}"

	# Refuse to upgrade packages while a build is running: swapping
	# compilers or libraries under a live run_build.pl can corrupt it.
	# The build-farm client serializes runs with a per-branch advisory
	# lock on buildroot/<branch>/builder.LCK (flock, LOCK_EX). Probing
	# that same lock is the definitive check: a stale lock file can
	# exist on disk without a running build, so we test the lock itself
	# rather than the file's presence. Perl is used because it is
	# present on every animal (the client is Perl) and its flock works
	# uniformly on Linux and *BSD, unlike the flock(1) utility.
	LOCKJSON=$(salt-ssh "${THIS_ANIMAL}" --out json -r "perl -e 'use Fcntl qw(:flock); my \$busy = 0; for my \$f (glob(\"${THIS_ANIMAL}/buildroot/*/builder.LCK\")) { open(my \$fh, \"<\", \$f) or next; \$busy = 1 unless flock(\$fh, LOCK_EX | LOCK_NB); close(\$fh); } print \$busy ? \"1\" : \"0\";'" | sed -n '/{/,$p')
	RETCODE=$(printf "%s" "${LOCKJSON}" | jq -r ".${THIS_ANIMAL} | if type == \"object\" then .retcode else \"none\" end")
	if [ ! "${RETCODE}" = "0" ]; then
		echo "Could not determine build status for ${THIS_ANIMAL} (retcode ${RETCODE}):"
		printf "%s\n" "${LOCKJSON}" | jq -r ".${THIS_ANIMAL} | if type == \"object\" then (.stdout, .stderr) | select(. != \"\") else . end"
		return 1
	fi

	RUNNING=$(printf "%s" "${LOCKJSON}" | jq -r ".${THIS_ANIMAL}.stdout")
	if [ "${RUNNING}" = "1" ]; then
		echo "A build is currently running for ${THIS_ANIMAL}; refusing to upgrade."
		return 4
	elif [ ! "${RUNNING}" = "0" ]; then
		echo "Could not determine build status for ${THIS_ANIMAL}."
		return 1
	fi

	echo "$(date '+%H:%M:%S') Upgrading packages on ${THIS_ANIMAL};" \
		"progress every ${PROGRESS_INTERVAL}s..."

	# Upgrade all installed packages. Reboots are left to the user; a
	# kernel/glibc upgrade will not take effect until you reboot.
	# Assumes passwordless sudo.
	case "${OSID}" in
	almalinux|fedora|rocky)
		run_progress "sudo dnf upgrade -y" || return 3 ;;
	centos)
		case "${OSVERSIONID}" in
		7*) run_progress "sudo yum update -y" || return 3 ;;
		*) run_progress "sudo dnf upgrade -y" || return 3 ;;
		esac
		;;
	rhel)
		case "${OSVERSIONID}" in
		7*) run_progress "sudo yum update -y" || return 3 ;;
		*) run_progress "sudo dnf upgrade -y" || return 3 ;;
		esac
		;;
	debian|ubuntu)
		run_progress "DEBIAN_FRONTEND=noninteractive sudo apt-get update && DEBIAN_FRONTEND=noninteractive sudo apt-get --yes upgrade" || return 3 ;;
	freebsd)
		run_progress "sudo pkg update && sudo pkg upgrade -y" || return 3 ;;
	sles|opensuse-leap)
		run_progress "sudo zypper -n refresh && sudo zypper -n update -y" || return 3 ;;
	*) echo "Unhandled OS ${OSID} ${OSVERSIONID}"; return 1;;
	esac

	return 0
}

ERROR=""
NOOP=""
BUSY=""
SUCCESS=""
UNEXPECTED=""

# Select the animals first so that progress can be shown as N of TOTAL.
SELECTED=""
TOTAL=0
for THIS_ANIMAL in $(yq -r '. | keys[]' salt/roster); do
	if [ ! "${ANIMALS}" = "" ] && \
			! echo "${ANIMALS}" | grep -Eq "(^|,)${THIS_ANIMAL}(,|$)"; then
		continue
	fi
	SELECTED="${SELECTED} ${THIS_ANIMAL}"
	TOTAL=$((TOTAL + 1))
done

COUNT=0
for THIS_ANIMAL in ${SELECTED}; do
	COUNT=$((COUNT + 1))
	START=$(date +%s)
	echo "ANIMAL: ${THIS_ANIMAL} [${COUNT}/${TOTAL}] $(date '+%H:%M:%S')"
	do_work
	STATUS=${?}
	echo "${THIS_ANIMAL} finished with status ${STATUS}" \
		"in $(($(date +%s) - START))s"
	case "${STATUS}" in
	0) SUCCESS="${SUCCESS} ${THIS_ANIMAL}" ;;
	1) UNEXPECTED="${UNEXPECTED} ${THIS_ANIMAL}" ;;
	2) NOOP="${NOOP} ${THIS_ANIMAL}" ;;
	3) ERROR="${ERROR} ${THIS_ANIMAL}" ;;
	4) BUSY="${BUSY} ${THIS_ANIMAL}" ;;
	*) UNEXPECTED="${UNEXPECTED} ${THIS_ANIMAL}" ;;
	esac
done

echo "SUCCESS"
for ANIMAL in ${SUCCESS}; do
	echo "  ${ANIMAL}"
done

echo "NOTHING TO DO"
for ANIMAL in ${NOOP}; do
	echo "  ${ANIMAL}"
done

echo "BUILD RUNNING"
for ANIMAL in ${BUSY}; do
	echo "  ${ANIMAL}"
done

echo "ERROR"
for ANIMAL in ${ERROR}; do
	echo "  ${ANIMAL}"
done

echo "UNKNOWN ISSUE"
for ANIMAL in ${UNEXPECTED}; do
	echo "  ${ANIMAL}"
done
