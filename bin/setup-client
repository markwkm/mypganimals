#!/bin/sh

BUILD_ROOT='\$confdir/buildroot'
CONFIG_OPTS="--enable-cassert --enable-debug --enable-nls --with-perl --with-tcl --with-gssapi --with-ldap --with-libxml --with-libxslt"
EMAIL="markwkm@gmail.com"
GLOBAL_LOCK_DIR="/tmp"

export PYTHONWARNINGS="ignore"

# Run a command on this animal under sh. salt-ssh hands the command to
# the remote login shell, which can be csh (FreeBSD), and csh cannot
# parse \" inside double quotes or 2>/dev/null. The command is passed
# to sh -c in single quotes, which csh and sh parse the same way, with
# each embedded single quote written as '\''. csh also expands history
# on ! inside single quotes, so each ! is written as '\!', which both
# shells read as a literal !. Extra arguments go to salt-ssh.
remote()
{
	_cmd=$(printf '%s' "${1}" | sed "s/'/'\\\\''/g; s/!/'\\\\!'/g")
	shift
	salt-ssh "${THIS_ANIMAL}" "$@" -r "sh -c '${_cmd}'"
}

do_work()
{
	RC=$(remote "[ -d ${THIS_ANIMAL} ] && printf \"1\" || printf \"0\"" --out json | sed -n '/{/,$p' | jq -r ".${THIS_ANIMAL}.stdout")
	if [ "${RC}" = "0" ]; then
		echo "Build farm client is not downloaded for this ${THIS_ANIMAL}."
		return 2
	elif [ ! "${RC}" = "1" ]; then
		echo "Unknown issue with ${THIS_ANIMAL}."
		return 1
	fi

	# Disable this animal's scheduled builds before touching anything.
	# Idempotent: does nothing if there is no matching crontab entry.
	remote "crontab -l 2>/dev/null | sed '/#Ansible: ${THIS_ANIMAL}/{N;d;}' | crontab -" || return 3
	echo "Cron successfully disabled for ${THIS_ANIMAL}."

	# Make sure no build is currently running before rewriting the
	# config. The build-farm client serializes runs with a per-branch
	# advisory lock on buildroot/<branch>/builder.LCK (flock, LOCK_EX).
	# Testing that same lock is the definitive check: a stale lock file
	# can exist on disk without a running build, so we probe the lock
	# itself rather than the file's presence. Perl is used because it is
	# present on every animal (the client is Perl) and its flock works
	# uniformly on Linux and *BSD, unlike the flock(1) utility.
	RUNNING=$(remote "perl -e 'use Fcntl qw(:flock); my \$busy = 0; for my \$f (glob(\"${THIS_ANIMAL}/buildroot/*/builder.LCK\")) { open(my \$fh, \"<\", \$f) or next; \$busy = 1 unless flock(\$fh, LOCK_EX | LOCK_NB); close(\$fh); } print \$busy ? \"1\" : \"0\";'" --out json | sed -n '/{/,$p' | jq -r ".${THIS_ANIMAL}.stdout")
	if [ "${RUNNING}" = "1" ]; then
		echo "A build is currently running for ${THIS_ANIMAL}; skipping."
		return 4
	elif [ ! "${RUNNING}" = "0" ]; then
		echo "Could not determine build status for ${THIS_ANIMAL}."
		return 1
	fi

	remote "cp ${THIS_ANIMAL}/build-farm.conf.sample ${THIS_ANIMAL}/build-farm.conf" || return 3
 
	remote "sed -i.bak \"/animal[[:blank:]]*=>/ s/\\\"CHANGEME\\\"/\\\"${THIS_ANIMAL}\\\"/\" ${THIS_ANIMAL}/build-farm.conf" || return 3

	SECRET=$(yq -r ".${THIS_ANIMAL}.secret // \"\"" salt/roster)
	if [ ! "${SECRET}" = "" ]; then
		remote "sed -i.bak \"/secret[[:blank:]]*=>/ s/\\\"CHANGEME\\\"/\\\"${SECRET}\\\"/\" ${THIS_ANIMAL}/build-farm.conf" || return 3
	else
		echo "You must define a secret in the roster file!"
		return 3
	fi

	CC=$(yq -r ".${THIS_ANIMAL}.cc // \"\"" salt/roster)
	if [ ! "${CC}" = "" ]; then
		remote "sed -i.bak \"s/\\(CC[[:blank:]]*=>[[:blank:]]*'\\).*\\(',\\)/\\1${CC}\\2/\" ${THIS_ANIMAL}/build-farm.conf" || return 3
	fi

	CXX=$(yq -r ".${THIS_ANIMAL}.cxx // \"\"" salt/roster)
	if [ ! "${CXX}" = "" ]; then
		remote "sed -i.bak \"/CC[[:blank:]]*=>[[:blank:]]*'.*',/a CXX => '${CXX}',\" ${THIS_ANIMAL}/build-farm.conf" || return 3
	fi

	SCMREPO=$(yq -r ".${THIS_ANIMAL}.scmrepo // \"\"" salt/roster)
	if [ ! "${SCMREPO}" = "" ]; then
		remote "sed -i.bak \"s|scmrepo[[:blank:]]*=>[[:blank:]]*undef|scmrepo => '${SCMREPO}'|\" ${THIS_ANIMAL}/build-farm.conf" || return 3
	fi

	MAKE=$(yq -r ".${THIS_ANIMAL}.make // \"\"" salt/roster)
	if [ ! "${MAKE}" = "" ]; then
		remote "sed -i.bak \"s|make[[:blank:]]*=>[[:blank:]]*'make'|make => '${MAKE}'|\" ${THIS_ANIMAL}/build-farm.conf" || return 3
	fi

	VPATH=$(yq -r ".${THIS_ANIMAL}.vpath // \"\"" salt/roster)
	if [ "${VPATH}" = "true" ]; then
		remote "sed -i.bak \"s|use_vpath[[:blank:]]*=>[[:blank:]]*undef|use_vpath => 'true'|\" ${THIS_ANIMAL}/build-farm.conf" || return 3
	fi

	MESON=$(yq -r ".${THIS_ANIMAL}.meson // \"\"" salt/roster)
	if [ "${MESON}" = "true" ]; then
		remote "sed -i.bak \"s|using_meson[[:blank:]]*=>[[:blank:]]*undef|using_meson => 'true'|\" ${THIS_ANIMAL}/build-farm.conf" || return 3
	fi

	BRANCHES_TO_BUILD=$(yq -r ".${THIS_ANIMAL}.branches_to_build // \"\"" salt/roster)
	if [ ! "${BRANCHES_TO_BUILD}" = "" ]; then
		remote "sed -i.bak \"s|branches_to_build[[:blank:]]*=>[[:blank:]]*'ALL'|branches_to_build => '${BRANCHES_TO_BUILD}'|\" ${THIS_ANIMAL}/build-farm.conf" || return 3
	fi

	remote "sed -i.bak \"s|build_root[[:blank:]]*=>[[:blank:]]*undef|build_root => \\\"${BUILD_ROOT}\\\"|\" ${THIS_ANIMAL}/build-farm.conf" || return 3
	remote "sed -i.bak \"s|global_lock_dir[[:blank:]]*=>[[:blank:]]*undef|global_lock_dir => '${GLOBAL_LOCK_DIR}'|\" ${THIS_ANIMAL}/build-farm.conf" || return 3
	remote "sed -i.bak \"s/change[[:blank:]]*=>[[:blank:]]*\\\[\\\]/change => ['${EMAIL}']/\" ${THIS_ANIMAL}/build-farm.conf" || return 3
	remote "sed -i.bak \"s/fail[[:blank:]]*=>[[:blank:]]*\\\[\\\]/fail => ['${EMAIL}']/\" ${THIS_ANIMAL}/build-farm.conf" || return 3

	# This has the most sed & parsing problems, do this last so there are
	# fewer things to fix by hand.

	CONFIG_OPTS_EXTRA=$(yq -r ".${THIS_ANIMAL}.config_opts_extra // \"\"" salt/roster)
	ESCAPED_OPTS=$(echo "${CONFIG_OPTS} ${CONFIG_OPTS_EXTRA}" | sed 's/\//\\\//g')
	# Each sed command is a separate -e because BSD sed reads a label
	# name up to the end of the line, semicolons included.
	remote "sed -i.bak -e '/config_opts[[:blank:]]*=>[[:blank:]]*\[/{' -e ':a' -e 'N' -e '/)/!ba' -e 's/qw([^)]*)/qw(${ESCAPED_OPTS})/' -e '}' ${THIS_ANIMAL}/build-farm.conf" || return 3

	# Append meson_opts_extra to the sample's existing meson_opts qw()
	# block, mirroring the config_opts handling above. The two extras
	# lists are maintained by hand and kept in sync so the build is
	# equivalent regardless of the meson setting.
	#
	# The extras go after the qw() as separate q{} items, not inside
	# it. Meson array options such as -Dextra_include_dirs=a,b need a
	# comma, and the sample's "use warnings FATAL => 'qw'" turns a
	# comma inside qw() into a compile error. q{} is used rather than
	# '' because the sed expression is already single-quoted.
	MESON_OPTS_EXTRA=$(yq -r ".${THIS_ANIMAL}.meson_opts_extra // \"\"" salt/roster)
	if [ ! "${MESON_OPTS_EXTRA}" = "" ]; then
		MESON_ITEMS=""
		for OPT in ${MESON_OPTS_EXTRA}; do
			MESON_ITEMS="${MESON_ITEMS}, q{${OPT}}"
		done
		ESCAPED_MESON_ITEMS=$(echo "${MESON_ITEMS}" | sed 's/\//\\\//g')
		remote "sed -i.bak -e '/meson_opts[[:blank:]]*=>[[:blank:]]*\[/{' -e ':a' -e 'N' -e '/)/!ba' -e 's/qw(\([^)]*\))/qw(\1)${ESCAPED_MESON_ITEMS}/' -e '}' ${THIS_ANIMAL}/build-farm.conf" || return 3
	fi

	# sed -i takes the backup suffix attached (-i.bak) so the same
	# command works with both GNU and BSD sed. Drop the backup.
	remote "rm -f ${THIS_ANIMAL}/build-farm.conf.bak" || return 3

	return 0
}

ERROR=""
NOOP=""
BUSY=""
SUCCESS=""
UNEXPECTED=""

for THIS_ANIMAL in $(yq -r '. | keys[]' salt/roster); do
	if [ ! "${ANIMALS}" = "" ] && \
			! echo "${ANIMALS}" | grep -Eq "(^|,)${THIS_ANIMAL}(,|$)"; then
		continue
	fi

	echo "ANIMAL: ${THIS_ANIMAL}"
	do_work
	STATUS=${?}
	case "${STATUS}" in
	0) SUCCESS="${SUCCESS} ${THIS_ANIMAL}" ;;
	1) UNEXPECTED="${UNEXPECTED} ${THIS_ANIMAL}" ;;
	2) NOOP="${NOOP} ${THIS_ANIMAL}" ;;
	3) ERROR="${ERROR} ${THIS_ANIMAL}" ;;
	4) BUSY="${BUSY} ${THIS_ANIMAL}" ;;
	*) UNEXPECTED="${UNEXPECTED} ${THIS_ANIMAL}" ;;
	esac
done

echo "SUCCESS"
for ANIMAL in ${SUCCESS}; do
	echo "  ${ANIMAL}"
done

echo "NOTHING TO DO"
for ANIMAL in ${NOOP}; do
	echo "  ${ANIMAL}"
done

echo "BUILD RUNNING"
for ANIMAL in ${BUSY}; do
	echo "  ${ANIMAL}"
done

echo "ERROR"
for ANIMAL in ${ERROR}; do
	echo "  ${ANIMAL}"
done

echo "UNKNOWN ISSUE"
for ANIMAL in ${UNEXPECTED}; do
	echo "  ${ANIMAL}"
done
